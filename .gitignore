# Do not ignore gradlew/gradle-wrapper.jar/gradle-wrapper.properties —
# they must stay checked in for reliable CI builds.
!android/gradlew
!android/gradlew.bat
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties


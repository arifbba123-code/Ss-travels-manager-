rules_version = '2';

// ---------------------------------------------------------------------------
// SS Tours & Travels — Firestore Security Rules
//
// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console -> Firestore Database -> Rules)
//
// Model: every admin (Super Admin or Admin) has a document at
// admins/{uid}. Only signed-in users with an *active* admins/{uid}
// document may read or write business data. Only a Super Admin may
// manage other admins. The very first user ever to sign in is allowed
// to self-provision as the first Super Admin (see admins_meta/bootstrap
// below) — after that, only an existing Super Admin can create more.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && myAdminDoc().data.active == true;
    }

    function isActiveSuperAdmin() {
      return isActiveAdmin() && myAdminDoc().data.role == 'Super Admin';
    }

    function bootstrapAlreadyDone() {
      return exists(/databases/$(database)/documents/admins_meta/bootstrap)
        && get(/databases/$(database)/documents/admins_meta/bootstrap).data.bootstrapped == true;
    }

    // ---- admins ----
    match /admins/{uid} {
      // Anyone signed in may read their OWN doc (needed to resolve role
      // right after login) or any active admin may read the full roster
      // (needed for the Manage Admins screen).
      allow get: if isSignedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin();

      // Create: either (a) this is the very first admin ever (bootstrap,
      // enforced by admins_meta/bootstrap below) and the caller is
      // creating their OWN doc as Super Admin, or (b) an existing active
      // Super Admin is creating someone else's doc.
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && !bootstrapAlreadyDone() && request.resource.data.role == 'Super Admin')
        || isActiveSuperAdmin()
      );

      // Update / delete: only an active Super Admin, and a Super Admin
      // document can never be deactivated/deleted through the app.
      allow update: if isActiveSuperAdmin() && !(resource.data.role == 'Super Admin' && request.resource.data.active == false);
      allow delete: if isActiveSuperAdmin() && resource.data.role != 'Super Admin';
    }

    // One-time bootstrap flag — see admins/{uid} create rule above.
    match /admins_meta/bootstrap {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && !bootstrapAlreadyDone() && request.resource.data.bootstrappedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- everyday business data: any active admin can read/write ----
    match /vehicles/{id} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }

    match /drivers/{id} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }

    match /daily_collections/{id} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }

    match /expenses/{id} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }

    match /reports/{id} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update, delete: if isActiveSuperAdmin();
    }

    match /settings/{id} {
      allow read: if isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // ---- audit_logs: append-only, readable by any active admin ----
    match /audit_logs/{id} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
